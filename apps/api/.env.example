# Biến môi trường của API và worker khi chạy `pnpm dev` trên máy.
# Chép thành .env rồi sửa. Không commit .env.

NODE_ENV=development
PORT=4000
# PostgreSQL trong deploy/compose.dev.yaml
DATABASE_URL=postgresql://labfourt:labfourt@127.0.0.1:55432/labfourt
# Thời hạn phiên đăng nhập (giờ)
SESSION_TTL_HOURS=12
# false vì dev chạy http://localhost. Production luôn là true.
COOKIE_SECURE=false
LOG_LEVEL=info
# mock: dịch vụ AI và STT giả lập. http: dịch vụ thật theo docs/srs/07
AI_PROVIDER=mock
# Bắt buộc khi AI_PROVIDER=http
AI_BASE_URL=
AI_API_KEY=
# Chỉ cần khi STT chạy ở địa chỉ khác dịch vụ AI
STT_BASE_URL=
STT_API_KEY=
# Quản trị viên đầu tiên, dùng khi chạy seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=LabFourTAdmin2026
# CSDL riêng cho kiểm thử tích hợp, bị xóa và tạo lại mỗi lần chạy `pnpm test`.
# Bỏ trống thì các bài kiểm thử tích hợp được bỏ qua.
TEST_DATABASE_URL=postgresql://labfourt:labfourt@127.0.0.1:55432/labfourt_test
