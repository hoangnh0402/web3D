# Biến môi trường cho deploy/compose.yaml. Chép thành deploy/.env rồi đổi toàn bộ mật khẩu.
# Không commit deploy/.env.

# Tên miền trỏ về máy chủ (docs/srs/06 mục 7.1). Để localhost khi chạy thử trên một máy.
# Thử trên đúng một máy mà không muốn cảnh báo chứng chỉ: đặt http://localhost (bỏ HTTPS).
# Trình duyệt coi localhost là ngữ cảnh an toàn nên micro và cookie Secure vẫn chạy.
# Thiết bị khác trong mạng (điện thoại, iPad) bắt buộc dùng HTTPS và cài chứng chỉ gốc của Caddy.
SITE_ADDRESS=localhost

# PostgreSQL, chỉ dùng trong mạng nội bộ của Docker
POSTGRES_USER=labfourt
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=labfourt

# Thời hạn phiên đăng nhập (giờ)
SESSION_TTL_HOURS=12
LOG_LEVEL=info
# mock: dịch vụ AI và STT giả lập. http: dịch vụ thật theo docs/srs/07
AI_PROVIDER=mock
# Dịch vụ AI thật, chỉ cần khi AI_PROVIDER=http. Khóa chỉ nằm ở máy chủ.
AI_BASE_URL=
AI_API_KEY=
# Chỉ cần khi STT chạy ở địa chỉ khác dịch vụ AI. Bỏ trống thì dùng chung AI_BASE_URL, AI_API_KEY.
STT_BASE_URL=
STT_API_KEY=

# Quản trị viên đầu tiên, chỉ dùng khi chạy seed. Production cần mật khẩu từ 12 ký tự trở lên.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=doi-mat-khau-quan-tri-nay

# Sao lưu (deploy/backup/backup.sh)
BACKUP_DIR=/mnt/backup/lab-fourt
BACKUP_KEEP=14
