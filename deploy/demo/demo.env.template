# Cấu hình bản demo chạy trên một máy. CHAY-DEMO tự chép tệp này thành deploy/demo/.env ở lần chạy đầu.
# Không dùng cấu hình này cho máy chủ thật.

# Chỉ chạy HTTP trên chính máy này, không cần chứng chỉ
SITE_ADDRESS=http://localhost

POSTGRES_USER=labfourt
# Mật khẩu cố định: CSDL demo không mở cổng ra ngoài Docker. Nếu sinh ngẫu nhiên, giải nén bản mới sang thư mục khác
# sẽ tạo mật khẩu mới trong khi dữ liệu demo cũ vẫn giữ mật khẩu cũ, API không kết nối được.
POSTGRES_PASSWORD=labfourt-demo
POSTGRES_DB=labfourt

SESSION_TTL_HOURS=12
LOG_LEVEL=warn

# simple: thân chủ AI chạy ngay trên máy theo hồ sơ ca, không cần Internet hay khóa dịch vụ.
# Muốn dùng dịch vụ AI thật: đặt AI_PROVIDER=http, AI_PROTOCOL=openai và điền AI_BASE_URL, AI_MODEL, AI_API_KEY.
AI_PROVIDER=simple
AI_PROTOCOL=contract
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
STT_BASE_URL=
STT_API_KEY=

# Tài khoản quản trị của bản demo (ghi trong tài liệu hướng dẫn)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=LabFourTAdmin2026
